#!/bin/sh
# tmux config hash: {{ include "dot_config/tmux/tmux.conf" | sha256sum }}

set -eu

tpm_dir="$HOME/.tmux/plugins/tpm"
if [ ! -d "$tpm_dir/.git" ]; then
    git clone https://github.com/tmux-plugins/tpm "$tpm_dir"
fi

# TPM resolves its path by querying the default tmux server; a server
# auto-started before this config existed lacks TMUX_PLUGIN_MANAGER_PATH
# and TPM aborts. Set it explicitly so installs never depend on server state.
# (A fresh server gets the variable from the config it loads; only an
# already-running stale server needs patching. `start-server` alone exits
# immediately with no sessions, so never rely on it persisting.)
if tmux ls >/dev/null 2>&1; then
    tmux set-environment -g TMUX_PLUGIN_MANAGER_PATH "$HOME/.tmux/plugins/"
fi

"$tpm_dir/bin/install_plugins"
"$tpm_dir/bin/update_plugins" all

if tmux list-sessions >/dev/null 2>&1; then
    tmux source-file "$HOME/.config/tmux/tmux.conf"
fi

{{ if eq .chezmoi.os "darwin" -}}
# tmux boot hash: {{ include "dot_config/tmux/scripts/executable_tmux-boot" | sha256sum }}
# launch agent hash: {{ include "Library/LaunchAgents/com.orion.tmux-server.plist.tmpl" | sha256sum }}
service="gui/$(id -u)/com.orion.tmux-server"
plist="$HOME/Library/LaunchAgents/com.orion.tmux-server.plist"
if launchctl print "$service" >/dev/null 2>&1; then
    launchctl bootout "$service"
fi
if launchctl print "gui/$(id -u)" >/dev/null 2>&1; then
    launchctl bootstrap "gui/$(id -u)" "$plist"
else
    printf '%s\n' 'tmux launch agent: no active GUI session; skipping launchd bootstrap'
fi
{{ end -}}
