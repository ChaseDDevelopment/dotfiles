#!/bin/sh

set -eu

config_file="${XDG_CONFIG_HOME:-$HOME/.config}/chezmoi-ai/chezmoi.toml"

if [ ! -f "$config_file" ]; then
    printf '%s\n' \
        "chezmoi-ai: $config_file not found." \
        'Clone the ai-dotfiles repository anywhere and run its bootstrap.sh once.' >&2
    exit 1
fi

exec chezmoi --config "$config_file" "$@"
