{{- if eq .chezmoi.os "darwin" -}}
#!/bin/sh
# tools: systemd-language-server nginx-language-server basedpyright ruff sqlfluff

set -eu

PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"

command -v uv >/dev/null 2>&1 || {
    printf '%s\n' 'uv tools: uv is missing; run the native package install first (brew installs uv)' >&2
    exit 1
}

install_tool() {
    if command -v "$2" >/dev/null 2>&1; then
        printf '%s\n' "uv tools: $2 already installed; skipping"
        return 0
    fi
    _pkg=$1
    shift 2
    uv tool install "$@" "$_pkg"
}

# systemd-language-server pins lxml<6, which cannot build on Python 3.14;
# 3.13 gets a prebuilt wheel. Drop the pin when upstream allows lxml 6.
install_tool systemd-language-server systemd-language-server --python 3.13
install_tool nginx-language-server nginx-language-server
install_tool basedpyright basedpyright-langserver
install_tool ruff ruff
install_tool sqlfluff sqlfluff
{{- else if and (eq .chezmoi.os "linux") (or (eq .chezmoi.osRelease.id "arch") (eq .chezmoi.osRelease.id "ubuntu") (eq .chezmoi.osRelease.id "debian")) -}}
#!/bin/sh
# tools: systemd-language-server nginx-language-server basedpyright ruff sqlfluff
# Needs libxml2/libxslt dev headers on APT hosts (packages.yaml) — lxml may
# build from source when uv's managed Python is ahead of published wheels.

set -eu

PATH="/usr/local/bin:$PATH"

if [ "$(id -u)" -eq 0 ]; then
    run_root() {
        "$@"
    }
else
    command -v sudo >/dev/null 2>&1 || {
        printf '%s\n' 'uv tools: sudo is required when not running as root' >&2
        exit 1
    }
    run_root() {
        sudo "$@"
    }
fi

{{ if eq .chezmoi.osRelease.id "arch" -}}
command -v uv >/dev/null 2>&1 || {
    printf '%s\n' 'uv tools: uv is missing; run the native package install first (pacman installs uv)' >&2
    exit 1
}
{{ else -}}
# Check in root's PATH context: uv tool installs run through run_root, and a
# user-local ~/.local/bin/uv (old installer remnant) is invisible to sudo's
# secure_path — a user-context check here would skip the install and then 127.
if ! run_root sh -c 'command -v uv >/dev/null 2>&1'; then
    tmp_script=$(mktemp)
    trap 'rm -f -- "$tmp_script"' 0
    curl --fail --location --silent --show-error \
        --output "$tmp_script" https://astral.sh/uv/install.sh
    run_root env UV_INSTALL_DIR=/usr/local/bin UV_NO_MODIFY_PATH=1 \
        sh "$tmp_script"
fi
{{ end -}}

install_tool() {
    if command -v "$2" >/dev/null 2>&1; then
        printf '%s\n' "uv tools: $2 already installed; skipping"
        return 0
    fi
    _pkg=$1
    shift 2
    run_root env UV_TOOL_DIR=/opt/uv-tools UV_TOOL_BIN_DIR=/usr/local/bin \
        uv tool install "$@" "$_pkg"
}

# systemd-language-server pins lxml<6, which cannot build on Python 3.14;
# 3.13 gets a prebuilt wheel. Drop the pin when upstream allows lxml 6.
install_tool systemd-language-server systemd-language-server --python 3.13
install_tool nginx-language-server nginx-language-server
install_tool basedpyright basedpyright-langserver
install_tool ruff ruff
install_tool sqlfluff sqlfluff
{{- end }}
